{
  "name": "db-firewall",
  "version": "0.1.0",
  "description": "DB Firewall CLI for PostgreSQL: install the tenant RLS policies, scan them, and verify isolation as your app's role.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "db-firewall": "./dist/cli.js"
  },
  "files": ["dist", "sql", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/copy-sql.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "keywords": ["postgres", "rls", "row-level-security", "multi-tenant", "ai-agent", "cli", "security-scanner"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackbear/DB-firewall.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
