# Copy to .env.local and fill in. Generate each secret with: openssl rand -hex 32
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/starter
# The app role (no superuser, no BYPASSRLS): the MCP server connects as it.
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/starter
# The key the migration installs; the MCP server signs each tenant with it.
DB_FIREWALL_TENANT_KEY=
# Shared by the app (which signs a token per request) and the MCP server (which verifies it).
MCP_JWT_SECRET=
SESSION_SECRET=
MCP_URL=http://127.0.0.1:3333/mcp
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
